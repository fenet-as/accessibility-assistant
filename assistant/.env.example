# ALX Accessibility Assistant Configuration
# Pluggable AI provider: 'faq' (offline fallback) or 'cloud' (e.g. Gemini)
AI_PROVIDER=faq

# Cloud AI Settings (when AI_PROVIDER=cloud)
GEMINI_API_KEY=

# Server Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000,http://localhost:8000,null

# Telegram Settings (for adapter)
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=

# Jitsi Base URL for learner-controlled screen sharing
JITSI_BASE_URL=https://meet.jit.si

