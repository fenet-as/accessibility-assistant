# Copy to .env in the project root. Every value is optional; defaults run fully offline.

# --- AI provider -------------------------------------------------------------
# cloud = Google Gemini primary; FAQ fallback on timeout/error/bad citations (demo default)
# faq   = offline extractive answers only (no key, no cost)
# local = OpenAI-compatible local model with FAQ fallback
AI_PROVIDER=cloud
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=45
# Optional: force FAQ-first extractive routing (default false — Gemini primary)
PREFER_EXTRACTIVE=false
# Whisper STT for the widget microphone (falls back to browser speech API when unset)
OPENAI_API_KEY=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1
STT_MAX_BYTES=8388608
STT_MAX_SECONDS=60
STT_TIMEOUT_SECONDS=30
LOCAL_MODEL_URL=
LOCAL_MODEL_NAME=local-model

# Which questions the assistant answers: education (course + VA, freelancing, remote work,
# digital skills, careers), course_only, or open (any question).
COURSE_SCOPE_POLICY=education

# Milestone 4: exact-answer cache and token budgets (Redis optional; falls back to in-memory)
ENABLE_EXACT_CACHE=true
REDIS_URL=
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=4096
MAX_CONTEXT_TOKENS=800
MAX_OUTPUT_TOKENS=600
MAX_CHARS_PER_PASSAGE=1500
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_IP_PER_MIN=60
RATE_LIMIT_STT_PER_MIN=6
# 0 disables the daily budget gate
DAILY_TOKEN_BUDGET=0
DAILY_COST_BUDGET_USD=0

# --- Server ------------------------------------------------------------------
# Public URL, used in the LTI 1.3 manifest
HOST_URL=http://localhost:8000
# Comma-separated origins allowed to embed the widget, or * for any LMS
CORS_ORIGINS=*
# uvicorn worker processes (Docker). Roughly one per CPU core.
WEB_CONCURRENCY=4

# --- Security ----------------------------------------------------------------
# When set, /api/admin/* (course ingestion/deletion) requires header X-Admin-Token
ADMIN_TOKEN=
# Local only: allow /api/admin/* when ADMIN_TOKEN is empty (default false)
ALLOW_OPEN_ADMIN=false
# Max lesson payload size for POST /api/admin/ingest
INGEST_MAX_CONTENT_CHARS=500000

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=assistant/data/assistant.db
CHUNKS_PATH=assistant/data/chunks.json

# --- Channels ----------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STAFF_CHAT_ID=
# Jitsi server for human-help rooms (public or self-hosted)
JITSI_BASE_URL=https://meet.jit.si
# redacted | off | raw
LOG_QUESTION_TEXT=redacted

# Optional real SMS outbound (any one is enough; otherwise replies stay local/simulator)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
