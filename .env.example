# ==============================================================================
# ALX Digital Bridge Accessibility Assistant — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Configuration (Pluggable Architecture)
# ------------------------------------------------------------------------------
# Choose: 'faq' (100% offline, zero-cost, no API key needed) or 'cloud' (Gemini)
AI_PROVIDER=faq

# If AI_PROVIDER=cloud, supply your Google Gemini API key here:
# (Obtain free at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Server & Network Deployment Settings
# ------------------------------------------------------------------------------
# For local dev: 127.0.0.1; For Docker / Cloud hosting (Render/Railway/Fly.io): 0.0.0.0
HOST=127.0.0.1
PORT=8000

# Public URL used in LTI 1.3 manifests and widget callbacks
HOST_URL=http://localhost:8000

# Allowed CORS origins for widget embedding (comma-separated or '*' for public LMS)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Database Persistence (SQLite)
# ------------------------------------------------------------------------------
# SQLite database file path. Automatically created on boot.
DATABASE_PATH=assistant/data/assistant.db

# ------------------------------------------------------------------------------
# 4. Omnichannel: Telegram Bot Settings (Optional)
# ------------------------------------------------------------------------------
# Create via @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=

# Designated staff/tutor Telegram group chat ID for escalation notifications:
TELEGRAM_STAFF_CHAT_ID=

# ------------------------------------------------------------------------------
# 5. Live Human Escalation & Jitsi Screen Share
# ------------------------------------------------------------------------------
# Base URL for WebRTC video rooms (public meet.jit.si or self-hosted instance):
JITSI_BASE_URL=https://meet.jit.si
