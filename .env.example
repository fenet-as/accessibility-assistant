# Copy to .env in the project root. Every value is optional; defaults run fully offline.

# --- AI provider -------------------------------------------------------------
# faq   = offline extractive answers (no key, no cost)
# cloud = Google Gemini; falls back to faq automatically on any failure
AI_PROVIDER=faq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Server ------------------------------------------------------------------
# Public URL, used in the LTI 1.3 manifest
HOST_URL=http://localhost:8000
# Comma-separated origins allowed to embed the widget, or * for any LMS
CORS_ORIGINS=*
# uvicorn worker processes (Docker). Roughly one per CPU core.
WEB_CONCURRENCY=4
# Cached answers per worker; identical questions in one course skip the AI call
ANSWER_CACHE_SIZE=1024

# --- Security ----------------------------------------------------------------
# When set, /api/admin/* (course ingestion/deletion) requires header X-Admin-Token
ADMIN_TOKEN=

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=assistant/data/assistant.db
CHUNKS_PATH=assistant/data/chunks.json

# --- Channels ----------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Jitsi server for human-help rooms (public or self-hosted)
JITSI_BASE_URL=https://meet.jit.si

# Optional real SMS outbound (any one is enough; otherwise replies stay local/simulator)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
